rec {
  run = builtins.raylib;
  validate = commands: builtins.raylibValidate commands;
  validateAudio = actions: builtins.raylibValidateAudio actions;
  version = builtins.raylibVersion;
  worldToScreen2D = builtins.raylibWorldToScreen2D;
  screenToWorld2D = builtins.raylibScreenToWorld2D;
  checkCollisionRecs = builtins.raylibCheckCollisionRecs;
  checkCollisionCircles = builtins.raylibCheckCollisionCircles;
  checkCollisionCircleRec = builtins.raylibCheckCollisionCircleRec;
  checkCollisionPointRec = builtins.raylibCheckCollisionPointRec;
  checkCollisionPointCircle = builtins.raylibCheckCollisionPointCircle;
  checkCollisionPointTriangle = builtins.raylibCheckCollisionPointTriangle;
  checkCollisionPointPoly = builtins.raylibCheckCollisionPointPoly;
  checkCollisionPointLine = builtins.raylibCheckCollisionPointLine;
  checkCollisionCircleLine = builtins.raylibCheckCollisionCircleLine;
  checkCollisionLines = builtins.raylibCheckCollisionLines;
  getCollisionRec = builtins.raylibGetCollisionRec;

  rgba = r: g: b: a: [ r g b a ];
  rgb = r: g: b: rgba r g b 255;
  colors = {
    white = rgb 255 255 255;
    raywhite = rgb 245 245 245;
    black = rgb 0 0 0;
    gray = rgb 130 130 130;
    red = rgb 230 41 55;
    green = rgb 0 228 48;
    blue = rgb 0 121 241;
    skyblue = rgb 102 191 255;
    yellow = rgb 253 249 0;
    orange = rgb 255 161 0;
    purple = rgb 200 122 255;
    blank = rgba 0 0 0 0;
  };
  keys = {
    space = 32;
    a = 65; d = 68; s = 83; w = 87;
    escape = 256; enter = 257;
    right = 262; left = 263; down = 264; up = 265;
  };
  mouse = { left = 0; right = 1; middle = 2; };
  keyDown = frame: key: builtins.elem key frame.keysDown;
  keyPressed = frame: key: builtins.elem key frame.keysPressed;
  keyReleased = frame: key: builtins.elem key frame.keysReleased;
  mouseReleased = frame: button: builtins.elem button frame.mouseReleased;

  playSound = sound: { op = "playSound"; inherit sound; };
  pauseSound = sound: { op = "pauseSound"; inherit sound; };
  resumeSound = sound: { op = "resumeSound"; inherit sound; };
  stopSound = sound: { op = "stopSound"; inherit sound; };
  setSoundVolume = args: args // { op = "setSoundVolume"; };
  setSoundPitch = args: args // { op = "setSoundPitch"; };
  setSoundPan = args: args // { op = "setSoundPan"; };
  playMusic = music: { op = "playMusic"; inherit music; };
  pauseMusic = music: { op = "pauseMusic"; inherit music; };
  resumeMusic = music: { op = "resumeMusic"; inherit music; };
  stopMusic = music: { op = "stopMusic"; inherit music; };
  setMusicVolume = args: args // { op = "setMusicVolume"; };
  setMusicPitch = args: args // { op = "setMusicPitch"; };
  setMusicPan = args: args // { op = "setMusicPan"; };
  seekMusic = args: args // { op = "seekMusic"; };

  clear = color: { op = "clear"; inherit color; };
  clip = args: args // { op = "clip"; };
  camera2D = args: args // { op = "camera2D"; };
  blend = args: args // { op = "blend"; };
  shader = args: args // { op = "shader"; };
  paint = args: args // { op = "paint"; };
  text = args: args // { op = "text"; };
  texture = args: args // { op = "texture"; };
  rectangle = args: args // { op = "rectangle"; };
  rectangleLines = args: args // { op = "rectangleLines"; };
  rectangleRounded = args: args // { op = "rectangleRounded"; };
  rectangleRoundedLines = args: args // { op = "rectangleRoundedLines"; };
  circle = args: args // { op = "circle"; };
  circleLines = args: args // { op = "circleLines"; };
  ellipse = args: args // { op = "ellipse"; };
  ellipseLines = args: args // { op = "ellipseLines"; };
  triangle = args: args // { op = "triangle"; };
  triangleLines = args: args // { op = "triangleLines"; };
  line = args: args // { op = "line"; };
  pixel = args: args // { op = "pixel"; };
  fps = x: y: { op = "fps"; inherit x y; };
}
